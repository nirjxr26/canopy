# Copy to .env and fill in. All keys optional in dev unless marked REQUIRED.

# --- runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=0
HTTPS_ENFORCED=false
# Run pending migrations at startup before accepting traffic (single-instance deploys).
# Multi-instance deployments must migrate out-of-band (npm run migrate) to avoid boot races.
RUN_MIGRATIONS_ON_BOOT=false

# --- database (REQUIRED) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auuth
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- origins (REQUIRED) ---
FRONTEND_URL=http://localhost:5173
AUTH_BASE_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- cookies / sessions ---
# COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_EXPIRY_DAYS=30
SESSION_IDLE_HOURS=12
MAX_ACTIVE_SESSIONS=5
# SESSION_SECRET=accepted but unused; sessions use per-session CSPRNG secrets

# --- MFA at-rest encryption (REQUIRED: ordered v<version>:<base64 key>, newest first) ---
#   generate each key with: openssl rand -base64 32
MFA_ENCRYPTION_KEYS=v2:REPLACE_WITH_32_BYTE_KEY_BASE64,v1:REPLACE_WITH_32_BYTE_KEY_BASE64

# --- argon2id (centralized hashing params) ---
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1
ARGON_HASH_LENGTH=32

# --- rate limiting ---
RATE_LIMITER_BACKEND=memory
REDIS_URL=redis://localhost:6379
# RATE_LIMITS_JSON={"loginIp":{"limit":20,"windowMs":60000}}

# --- brute force / lockout ---
LOCK_DURATION_MIN=15
MFA_MAX_FAILED_ATTEMPTS=5

# --- service-to-service + consumer JWTs (REQUIRED in production) ---
# SERVICE_API_KEY=generate-a-long-random-string
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#   (RS256 PKCS8 PEM. Single line with \n escapes, or real newlines inside double quotes.)
# JWT_ISSUER=http://localhost:3000
# JWT_AUDIENCE=http://localhost:3000
# JWT_KID=ap-v1
JWT_ACCESS_TTL_SECONDS=900

# --- email ---
# console = log to stdout + store in email_outbox (no real delivery). Use for dev.
# smtp   = real delivery via nodemailer (SMTP_URL required). Examples:
#   Gmail app password: smtps://you@gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:465
#   Brevo:              smtp://smtp-relay.brevo.com:587 with SMTP_USER/SMTP_PASS? -> use smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
#   Resend:             smtps://resend:re_YOUR_KEY@smtp.resend.com:465
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@localhost
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_RETRY_MAX=5
EMAIL_RETRY_BACKOFF_MS=30000

# --- retention ---
RETENTION_DAYS=90
