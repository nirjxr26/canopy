{
  "name": "auuth",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w apps/api",
    "migrate": "npm run migrate -w apps/api"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
